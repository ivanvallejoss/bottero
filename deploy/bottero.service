[Unit]
Description=bottero WhatsApp bot
Documentation=https://github.com/ivanvallejoss/bottero
# Start once the network is configured. The bot also retries on its own if
# the first connection fails (the Wi-Fi may take longer to come back).
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bottero
Group=bottero
ExecStart=/usr/local/bin/bottero run -config /etc/bottero/config.json -data-dir /var/lib/bottero

# /var/lib/bottero holds the whatsmeow session (session.db) and the bot's own
# state (state.db): the messages waiting for a reply and the record of those
# already attended. systemd creates it if needed and makes the service user
# its owner.
StateDirectory=bottero
StateDirectoryMode=0700

# Restart after failures, but not after exit code 3 (the session is gone or
# WhatsApp ended it: logged out, ban, replaced, outdated client) or 4 (the
# configuration file is missing or invalid). Restarting would not fix either;
# the journal shows the reason.
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=3 4

# Basic sandbox: no privilege escalation, read-only system, no access to
# home directories, private /tmp. The only writable path is StateDirectory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
